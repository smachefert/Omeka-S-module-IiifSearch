msgstr ""
"Nettoyage en arrière-plan des anciens médias créés par le module ; la sous-"
"tâche de réextraction ocr sera lancée automatiquement à la fin (tâche "
"%1$s#%2$s%3$s, %4$sjournaux%3$s)."

#: Module.php:895
#, php-format
msgid ""
"Cleaning up legacy module-created medias in background (job %1$s#%2$s%3$s, "
"%4$slogs%3$s)."
msgstr ""
"Nettoyage des médias créés par les anciennes versions du module en arrière-"
"plan (tâche %1$s#%2$s%3$s, %4$sjournaux%3$s)."

#: Module.php:910
#, php-format
msgid ""
"Cleaning up OCR files of excluded items in background (job %1$s#%2$s%3$s, "
"%4$slogs%3$s)."
msgstr ""
"Nettoyer les fichiers ocr des contenus exclus en arrière-plan (tâche "
"%1$s#%2$s%3$s, %4$sjournaux%3$s)."

#: Module.php:939
#, php-format
