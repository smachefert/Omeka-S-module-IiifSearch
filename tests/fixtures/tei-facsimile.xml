  <text>
    <front>
      <div type="titlePage">
        <pb n="i" facs="#s1"/>
        <p>Title page, without head: not a section.</p>
      </div>
    </front>
    <body>
      <div type="chapter">
        <pb n="1" facs="#s2"/>
        <head>Chapter I, of the beginning<note>A note that is not part of the label.</note></head>
        <p>Text.</p>
        <div type="section">
          <head>First<lb/>section</head>
          <p>Text.</p>
        </div>
        <div type="section">
          <pb n="2" facs="#s3"/>
          <head>Second section</head>
          <p>Text.</p>
        </div>
      </div>
      <div type="chapter">
        <head>Chapter II</head>
        <p>Starts in the middle of the page 2.</p>
        <pb n="3" facs="#g4"/>
        <p>Text.</p>
        <pb n="4" facs="#s5"/>
        <div type="section"><head>Last section</head><p>Starts in the middle of the page 4.</p></div>
      </div>
    </body>
  </text>
